# ==========================================
# LAST-MILE DELIVERY TRACKER ENVIRONMENT CONFIG
# ==========================================

# Backend API
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/last_mile_tracker
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Email Provider Configuration (mock for dev, smtp/resend for prod)
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM="LastMile Logistics <noreply@lastmile.com>"

# SMS Provider Configuration (mock for dev, twilio for prod)
SMS_PROVIDER=mock
SMS_ACCOUNT_SID=your_twilio_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM=+15005550006

# Frontend Next.js Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
