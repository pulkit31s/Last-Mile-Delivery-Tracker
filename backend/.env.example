PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/last_mile_tracker
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Email Configuration (Leave mock for local testing)
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM="LastMile Logistics <noreply@lastmilelogistics.com>"

# SMS Configuration (Gracefully falls back to mock/logger)
SMS_PROVIDER=mock
SMS_ACCOUNT_SID=your_twilio_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM=+15005550006
